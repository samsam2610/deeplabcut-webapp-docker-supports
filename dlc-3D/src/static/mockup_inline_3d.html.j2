{% extends "base.html" %}

{% block title %}Inline-3D Reorg Mockup{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{{ url_for('dlc_3d.static', filename='dlc_3d.css') }}">
<link rel="stylesheet" href="{{ url_for('dlc_3d.static', filename='viewer_3d.css') }}">
<link rel="stylesheet" href="{{ url_for('dlc_3d.static', filename='inline_analysis_3d.css') }}">
<link rel="stylesheet" href="{{ url_for('dlc_3d.static', filename='lp_cards.css') }}">
<style>
  /* ── Mockup-only chrome (not shipped) ─────────────────────────────── */
  .mk-wrap { max-width: 1500px; margin: 1rem auto; padding: 0 1rem; }
  .mk-note { background: color-mix(in srgb, var(--accent) 12%, transparent);
             border: 1px solid var(--accent); border-radius: 8px;
             padding: .6rem .8rem; margin-bottom: 1rem; font-size: .82rem; color: var(--text); }
  .mk-note b { color: var(--accent); }
  .mk-legend { font-size: .76rem; color: var(--text-dim); margin-top: .4rem; line-height: 1.7; }
  .mk-badge { display: inline-flex; align-items: center; justify-content: center;
              width: 18px; height: 18px; border-radius: 50%; background: var(--accent);
              color: #04140f; font-weight: 700; font-size: .68rem; margin-right: .25rem; flex-shrink: 0; }
  .mk-q { color: #facc15; font-weight: 700; }
  .mono { font-family: var(--mono); }

  /* Full-width card on video-select */
  #inline-analysis-3d-card.mk-card { display: block; max-width: none; width: 100%; }

  /* Two-column shell: viewer+controls (left) | finalize sub-card (right) */
  .mk-split { display: flex; gap: 1rem; align-items: flex-start; }
  .mk-left  { flex: 1 1 0; min-width: 0; position: relative; }
  .mk-right { width: 300px; flex-shrink: 0; }

  /* Keyframe-lock: red flag above the cam0 label + red range block on the seek bar */
  .mk-lock-flag { display: inline-flex; align-items: center; gap: .3rem; margin-bottom: .4rem;
                  background: color-mix(in srgb, #ef4444 25%, #11161a);
                  border: 1px solid #ef4444; color: #fca5a5;
                  padding: .22rem .5rem; border-radius: 6px; font-size: .72rem; font-weight: 600; }
  .mk-seek-wrap { position: relative; margin-top: .5rem; }
  .mk-seek-wrap .mk-seek { margin-top: 0; }
  .mk-lock-out { position: absolute; top: 0; bottom: 0; background: rgba(0,0,0,.45); pointer-events: none; }
  .mk-lock-range { position: absolute; top: 0; bottom: 0; left: 38%; width: 24%; pointer-events: none;
                   background: color-mix(in srgb, #ef4444 35%, transparent);
                   border: 1px solid #ef4444; border-radius: 3px; }

  /* Placeholder viewer tiles */
  .mk-tile-row { display: flex; gap: .75rem; }
  .mk-tile { flex: 1 1 0; min-width: 0; }
  .mk-tile-label { font-size: .72rem; color: var(--text-dim); margin-bottom: .2rem; }
  .mk-tile-canvas { width: 100%; aspect-ratio: 16/10; background:
       repeating-linear-gradient(45deg, #1a1f24, #1a1f24 10px, #20262c 10px, #20262c 20px);
       border-radius: 6px; display: flex; align-items: center; justify-content: center;
       color: var(--text-dim); font-size: .8rem; }
  .mk-size-row { display: flex; align-items: center; gap: .4rem; margin-top: .3rem;
                 font-size: .72rem; color: var(--text-dim); }
  .mk-size-row input[type=range] { flex: 1 1 0; accent-color: var(--accent); height: 14px; }

  /* Grey timeline canvases */
  .mk-canvas { width: 100%; height: 16px; background: #14181c; border-radius: 3px;
               display: block; border: 1px solid #2a3138; }
  .mk-seek { height: 14px; background: linear-gradient(90deg,#1b2228,#222a31); }

  /* Compact status/note/finalize row header (clip-cutter style) */
  .mk-bar { margin-top: .5rem; }
  .mk-bar-header { display: flex; align-items: center; gap: .35rem; margin-bottom: .2rem; flex-wrap: wrap; }
  .mk-bar-label { font-weight: 600; color: var(--text); font-size: .8rem; }
  .mk-chip { display: inline-flex; align-items: center; gap: .25rem; padding: .08rem .4rem;
             border-radius: 10px; font-size: .68rem; border: 1px solid #39424b; color: var(--text-dim); }
  .mk-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c, #34d399); }

  /* Per-frame status/note edit row below each timeline (writes cam0 companion CSV) */
  .mk-edit-row { display: flex; align-items: center; gap: .4rem; margin-top: .35rem; flex-wrap: wrap; }
  .mk-edit-input { flex: 0 0 180px; background:#11161a; border:1px solid #2a3138; color:var(--text);
                   border-radius:4px; padding:.25rem .4rem; font-size:.76rem; }
  .mk-edit-tags { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
  .mk-edit-tags .mk-tags-lbl { font-size: .68rem; color: var(--text-dim); }

  .mk-ctrl-row { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; }
  .mk-pbtn { min-width: 30px; padding: .25rem .45rem; }

  /* Frame counter + time (kept compact) */
  .mk-counter { font-family: var(--mono); font-size: .76rem; color: var(--text); }
  .mk-time { font-family: var(--mono); font-size: .72rem; color: var(--text-dim); }

  /* Body-marker chips: fill the empty space below the buttons + frame#/time */
  .mk-bp-chips { flex: 1 1 0; display: flex; flex-wrap: wrap; align-items: flex-start;
                 align-content: flex-start; gap: .35rem; padding-top: .4rem; border-top: 1px solid #20262c; }

  .mk-controls-flank { display: flex; gap: .8rem; align-items: stretch; }
  /* left region: [buttons + frame#/time] on top, chips fill below */
  .mk-controls-left { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: .5rem; }
  .mk-ctrl-top { display: flex; align-items: center; gap: .8rem; }
  .mk-controls-main { flex: 0 0 auto; display: flex; flex-direction: column; }
  /* 3: compact frame#/time beside the buttons */
  .mk-meta-mid { display: flex; align-items: center; gap: .4rem;
                 padding-left: .7rem; border-left: 1px solid #20262c; }
  /* Analysis-button group beside the controls (roomy, vertical stack) */
  .mk-start-flank { width: 270px; flex-shrink: 0; display: flex; flex-direction: column;
                    align-items: stretch; justify-content: center; gap: .4rem;
                    border-left: 1px solid #2a3138; padding-left: .9rem; }
  .mk-start-flank .btn-sm { width: 100%; padding: .5rem; }
  .mk-start-flank .mk-badge { align-self: flex-start; }
  .mk-start-count { font-size: .74rem; color: var(--text); text-align: center; }
  .mk-start-count b { color: var(--accent); }
  .mk-start-hint { font-size: .66rem; color: var(--text-dim); text-align: center; line-height: 1.4; }

  .mk-subpanel { border: 1px solid #2a3138; border-radius: 8px; padding: .6rem .7rem; margin-top: 1rem; }
  .mk-subpanel-title { font-weight: 600; font-size: .85rem; margin-bottom: .5rem; display:flex; align-items:center; gap:.4rem; }
  .mk-field { display: flex; align-items: center; gap: .4rem; margin-bottom: .4rem; font-size: .78rem; }
  .mk-field label { color: var(--text-dim); min-width: 64px; }
  .mk-field input[type=number], .mk-field input[type=text] {
       width: 80px; background: #11161a; border: 1px solid #2a3138; color: var(--text);
       border-radius: 4px; padding: .2rem .35rem; font-family: var(--mono); }
  .mk-field input[type=text].mk-postfix-input { width: 120px; }
  .mk-range { font-family: var(--mono); font-size: .78rem; color: var(--accent); margin: .3rem 0; }
  .mk-btnstack { display: flex; flex-direction: column; gap: .4rem; margin-top: .5rem; }
  .mk-muted { opacity: .5; }

  /* Postfix quick-tags (persisted to project sqlite, click-to-fill) */
  .mk-postfix-tags { display: flex; flex-wrap: wrap; gap: .3rem; margin: .1rem 0 .5rem 0; }
  .mk-ptag { display: inline-flex; align-items: center; gap: .25rem; padding: .12rem .45rem;
             border-radius: 10px; font-size: .7rem; cursor: pointer;
             border: 1px solid var(--accent); color: var(--accent);
             background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .mk-ptag .x { opacity: .5; font-size: .72rem; }
  .mk-ptag-add { border-style: dashed; border-color: #39424b; color: var(--text-dim);
                 background: transparent; }

  .mk-dim-card { border: 1px dashed #39424b; border-radius: 8px; padding: .55rem .7rem; margin-top: 1rem;
                 color: var(--text-dim); font-size: .8rem; }
</style>
{% endblock %}

{% block content %}
<div class="mk-wrap">
  <div class="mk-note">
    <b>MOCKUP v2 — proposed inline-3D analysis reorg</b> (layout only; nothing is wired).
    What the card looks like <i>after a video is selected</i>.
    <div class="mk-legend">
      <span class="mk-badge">1</span> Card expands to full page width.&nbsp;&nbsp;
      <span class="mk-badge">2</span> Analysis buttons beside the controls: <i>"Start analysis from current frame"</i> (with a frame-count line above) + a gated <i>"Start analysis for range"</i>.&nbsp;&nbsp;
      <span class="mk-badge">3</span> Frame # + time moved between the control buttons and the analysis buttons.&nbsp;&nbsp;
      <span class="mk-badge">4</span> Body-marker chips next, before the timelines.&nbsp;&nbsp;
      <span class="mk-badge">5</span> Status/Notes timelines compacted (nav + chips inline with the label).&nbsp;&nbsp;
      <span class="mk-badge">6</span> Finalize sub-card docked right (toggle checked by default).&nbsp;&nbsp;
      <span class="mk-badge">7</span> Finalize coverage timeline below Notes.&nbsp;&nbsp;
      <span class="mk-badge">8</span> Finalize postfix gets click-to-fill quick-tags, saved to project sqlite.&nbsp;&nbsp;
      <span class="mk-badge">9</span> <b>Keyframe lock</b> confines playback/seek to the finalize range — <span style="color:#fca5a5;">red block</span> on the main timeline + a red 🔒 flag top-left (shown in the locked state here).&nbsp;&nbsp;
      <span class="mk-badge">10</span> Per-frame <b>status/note edit</b> below each timeline (writes the cam0 companion CSV) with click-to-fill quick-tags beside the field, saved per project.
      <br>Per-tile <b>size sliders</b> shown under each camera. Dataset Curation + Create Clip stay full-width below (confirmed).
    </div>
  </div>

  <section class="card dlc-theme mk-card" id="inline-analysis-3d-card">
    <div class="mk-split">

      <!-- ─────────────────────────  LEFT: viewer + controls + timelines  ───────────────────────── -->
      <div class="mk-left">

        <!-- 9: red lock flag shown when the keyframe is locked (above the cam0 label) -->
        <div><span class="mk-lock-flag">🔒 range-locked · 1,034–1,833</span></div>

        <div class="mk-tile-row">
          <div class="mk-tile">
            <div class="mk-tile-label">cam0 · 050726_…_cam0</div>
            <div class="mk-tile-canvas">cam0 frame</div>
            <div class="mk-size-row"><span>size</span><input type="range" min="40" max="100" value="80"><span class="mono">80%</span></div>
          </div>
          <div class="mk-tile">
            <div class="mk-tile-label">cam1 · 050726_…_cam1</div>
            <div class="mk-tile-canvas">cam1 frame</div>
            <div class="mk-size-row"><span>size</span><input type="range" min="40" max="100" value="80"><span class="mono">80%</span></div>
          </div>
        </div>

        <!-- main seek bar (locked: red range block, dimmed outside) -->
        <div class="mk-seek-wrap">
          <canvas class="mk-canvas mk-seek"></canvas>
          <div class="mk-lock-out" style="left:0;width:38%;"></div>
          <div class="mk-lock-out" style="right:0;width:38%;"></div>
          <div class="mk-lock-range" title="navigation locked to the finalize range"></div>
        </div>

        <!-- controls (2 rows) + frame#/time on top; chips fill below; analysis flank on the right -->
        <div class="mk-controls-flank" style="margin-top:.55rem;">
          <div class="mk-controls-left">
            <div class="mk-ctrl-top">
              <div class="mk-controls-main">
                <div class="mk-ctrl-row">
                  <button class="btn-sm mk-pbtn">⏮</button>
                  <button class="btn-sm mk-pbtn">◀</button>
                  <button class="btn-sm mk-pbtn">⏯</button>
                  <button class="btn-sm mk-pbtn">▶</button>
                  <button class="btn-sm mk-pbtn">⏭</button>
                  <span style="color:var(--text-dim);font-size:.75rem;margin-left:.4rem;">fps</span>
                  <input type="number" value="30" style="width:54px;background:#11161a;border:1px solid #2a3138;color:var(--text);border-radius:4px;padding:.2rem;">
                  <span style="color:var(--text-dim);font-size:.75rem;">step</span>
                  <input type="number" value="1" style="width:46px;background:#11161a;border:1px solid #2a3138;color:var(--text);border-radius:4px;padding:.2rem;">
                </div>
                <div class="mk-ctrl-row" style="margin-top:.35rem;">
                  <button class="btn-sm mk-pbtn">⏪ N</button>
                  <button class="btn-sm mk-pbtn">N ⏩</button>
                  <input type="number" value="10" style="width:54px;background:#11161a;border:1px solid #2a3138;color:var(--text);border-radius:4px;padding:.2rem;">
                  <button class="btn-sm mk-pbtn">1</button>
                  <button class="btn-sm mk-pbtn">5</button>
                  <button class="btn-sm mk-pbtn">10</button>
                  <button class="btn-sm mk-pbtn">30</button>
                  <button class="btn-sm mk-pbtn">100</button>
                </div>
              </div>

              <!-- 3: compact frame # + time beside the controls -->
              <div class="mk-meta-mid">
                <span class="mk-badge">3</span>
                <span class="mk-counter">frame 1,234 / 252,901</span>
                <span class="mk-time">· 00:41.1</span>
                <button class="btn-sm mk-pbtn">?</button>
              </div>
            </div>

            <!-- 4: body-marker chips fill the empty space below the buttons + 3 -->
            <div class="mk-bp-chips">
              <span class="mk-badge">4</span>
              <span class="mk-chip" style="--c:#f87171;">nose ✓</span>
              <span class="mk-chip" style="--c:#fb923c;">l-ear ✓</span>
              <span class="mk-chip mk-muted" style="--c:#fbbf24;">r-ear</span>
              <span class="mk-chip" style="--c:#facc15;">l-paw ✓</span>
              <span class="mk-chip" style="--c:#a3e635;">r-paw ✓</span>
              <span class="mk-chip" style="--c:#34d399;">l-wrist ✓</span>
              <span class="mk-chip mk-muted" style="--c:#2dd4bf;">r-wrist</span>
              <span class="mk-chip" style="--c:#22d3ee;">l-elbow ✓</span>
              <span class="mk-chip" style="--c:#38bdf8;">r-elbow ✓</span>
              <span class="mk-chip" style="--c:#60a5fa;">spine1 ✓</span>
              <span class="mk-chip" style="--c:#818cf8;">spine2 ✓</span>
              <span class="mk-chip" style="--c:#a78bfa;">tail-base ✓</span>
              <span class="mk-chip mk-muted" style="--c:#c084fc;">tail-tip</span>
            </div>
          </div>

          <div class="mk-start-flank">
            <span class="mk-badge">2</span>
            <span class="mk-start-count">≈ <b>1,500</b> frames from current frame</span>
            <button class="btn-sm btn-create">▶ Start analysis from current frame</button>
            <button class="btn-sm btn-create">▶ Start analysis for range</button>
            <span class="mk-start-hint">keyframe is <b>locked</b> → "for range" is active &amp; analyzes the exact range (1,034 → 1,833). Unlock to disable.</span>
          </div>
        </div>

        <!-- ── supporting timelines ── -->
        <div class="mk-bar">
          <div class="mk-bar-header">
            <span class="mk-bar-label"><span class="mk-badge">5</span>Status</span>
            <button class="btn-sm mk-pbtn">◀</button>
            <button class="btn-sm mk-pbtn">▶</button>
            <span class="mk-chip" style="--c:#34d399;">reaching</span>
            <span class="mk-chip" style="--c:#f97316;">grooming</span>
            <span class="mk-chip" style="--c:#e879f9;">rest</span>
          </div>
          <canvas class="mk-canvas"></canvas>
          <!-- 10: edit status of the current frame in the cam0 companion CSV + quick-tags beside -->
          <div class="mk-edit-row">
            <span class="mk-badge">10</span>
            <input type="text" class="mk-edit-input" value="reaching" placeholder="status @ frame 1,234">
            <button class="btn-sm btn-create">Save</button>
            <span class="mk-edit-tags">
              <span class="mk-tags-lbl">tags:</span>
              <span class="mk-ptag">reaching <span class="x">×</span></span>
              <span class="mk-ptag">grooming <span class="x">×</span></span>
              <span class="mk-ptag">rest <span class="x">×</span></span>
              <span class="mk-ptag mk-ptag-add">+ tag</span>
            </span>
          </div>
        </div>

        <div class="mk-bar">
          <div class="mk-bar-header">
            <span class="mk-bar-label">Notes</span>
            <button class="btn-sm mk-pbtn">◀</button>
            <button class="btn-sm mk-pbtn">▶</button>
            <span class="mk-chip" style="--c:#60a5fa;">occluded</span>
            <span class="mk-chip" style="--c:#f472b6;">good</span>
          </div>
          <canvas class="mk-canvas"></canvas>
          <!-- edit note of the current frame in the cam0 companion CSV + quick-tags beside -->
          <div class="mk-edit-row">
            <input type="text" class="mk-edit-input" value="" placeholder="note @ frame 1,234">
            <button class="btn-sm btn-create">Save</button>
            <span class="mk-edit-tags">
              <span class="mk-tags-lbl">tags:</span>
              <span class="mk-ptag">occluded <span class="x">×</span></span>
              <span class="mk-ptag">good <span class="x">×</span></span>
              <span class="mk-ptag">blurry <span class="x">×</span></span>
              <span class="mk-ptag mk-ptag-add">+ tag</span>
            </span>
          </div>
        </div>

        <div class="mk-bar">
          <div class="mk-bar-header">
            <span class="mk-bar-label"><span class="mk-badge">7</span>Finalized frames</span>
            <button class="btn-sm mk-pbtn">◀</button>
            <button class="btn-sm mk-pbtn">▶</button>
            <span style="font-size:.7rem;color:var(--text-dim);">coverage of _analyzed</span>
          </div>
          <canvas class="mk-canvas" style="background:#0f1a14;"></canvas>
        </div>

      </div>

      <!-- ─────────────────────────  RIGHT: Finalize-analysis sub-card  ───────────────────────── -->
      <div class="mk-right">
        <div class="mk-subpanel" style="margin-top:0;">
          <div class="mk-subpanel-title">
            <span class="mk-badge">6</span>
            <input type="checkbox" checked> Finalize analysis
          </div>

          <div class="mk-field"><label>keyframe</label><input type="number" value="1234"> <input type="checkbox" checked> 🔒 <span style="color:#fca5a5;font-size:.7rem;">locked</span></div>
          <div class="mk-field"><label>before</label><input type="number" value="200"></div>
          <div class="mk-field"><label>after</label><input type="number" value="599"></div>
          <div class="mk-field"><label>length</label><input type="number" value="800"></div>
          <div class="mk-range">range: frames 1,034 – 1,833 (800)</div>

          <button class="btn-sm btn-create" style="width:100%;">Add range to _analyzed</button>

          <div style="border-top:1px solid #2a3138; margin:.7rem 0 .5rem;"></div>

          <div class="mk-field"><label>postfix</label><input type="text" class="mk-postfix-input" placeholder="(optional)"></div>

          <!-- click-to-fill quick-tags, persisted in project sqlite -->
          <div class="mk-subpanel-title" style="font-size:.74rem;margin:.2rem 0 .3rem;">
            <span class="mk-badge">8</span> postfix tags <span style="font-weight:400;color:var(--text-dim);">(click to fill · saved per project)</span>
          </div>
          <div class="mk-postfix-tags">
            <span class="mk-ptag">reach <span class="x">×</span></span>
            <span class="mk-ptag">good <span class="x">×</span></span>
            <span class="mk-ptag">retry <span class="x">×</span></span>
            <span class="mk-ptag mk-ptag-add">+ add tag</span>
          </div>

          <div class="mk-field"><input type="checkbox" checked> <span>both cams (cam0 + cam1)</span></div>

          <div class="mk-btnstack">
            <button class="btn-sm btn-create">Add range to _analyzed and extract clip</button>
            <button class="btn-sm">Rename clip</button>
            <button class="btn-sm">Delete clip (un-finalize)</button>
          </div>
          <div style="font-size:.72rem;color:var(--text-dim);margin-top:.5rem;">status: idle</div>
        </div>
      </div>

    </div>

    <!-- full-width sub-cards below (confirmed: stay here) -->
    <div class="mk-dim-card">
      <b>Dataset Curation</b> panel — stays here, full card width (collapsed).
    </div>
    <div class="mk-dim-card">
      <b>Create Clip</b> panel — stays here, full card width (collapsed).
    </div>

  </section>
</div>
{% endblock %}
